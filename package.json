{
  "name": "bidoor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3104",
    "build": "next build",
    "start": "next start -p 3104",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:layout": "node scripts/check-layout.mjs",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:up": "docker compose up -d && npm run db:migrate",
    "db:reset": "docker compose down -v && docker compose up -d && sleep 3 && npm run db:migrate",
    "db:migrate:test": "tsx scripts/migrate.mts --test",
    "db:purge-unpaid": "tsx scripts/purge-demo-entries.mts"
  },
  "dependencies": {
    "next": "16.3.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
