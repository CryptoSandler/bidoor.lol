# Postgres connection for the app, in every environment.
#
# Required, no default: a fallback would mean running against the wrong database
# rather than failing. In production this is set in the host's environment and
# never written to a file.
#
# Local development, with `docker compose up -d`:
#   postgres://bidoor:bidoor@localhost:55432/bidoor
# Neon: keep ?sslmode=require
DATABASE_URL=

# Postgres connection for the TEST SUITE, and nothing else.
#
# Deliberately a different variable. The suite truncates every table between
# tests, so this must point at a throwaway database — never one with real data.
# The suite refuses to start if it is the same as DATABASE_URL.
#
# Local: postgres://bidoor:bidoor@localhost:55432/bidoor_test
# Neon:  use a separate branch, not the production one.
TEST_DATABASE_URL=

# Load the demo fixture into an empty board. Development convenience only —
# it never runs under NODE_ENV=production regardless of this value.
# LOAD_DEMO_SEED=false

# The Solana wallet that receives bid payments, in USDC.
#
# Required, and there is deliberately no default: a fallback here would mean a
# misconfigured deploy quietly collects payments to somebody else's address.
# Without it the server refuses to take bids at all.
#
# Put the real receiving address in .env.local, which is gitignored. It must
# never appear in this file, in the code, or in any commit.
#
# This project only ever RECEIVES. It holds no private key, does no signing and
# has no withdrawal path — the wallet is operated entirely outside it.
PAYMENT_WALLET=YourSolanaWalletAddressHere

# Solana JSON-RPC endpoint used to verify payments.
# Optional; defaults to the public mainnet endpoint, which is heavily rate
# limited and should be replaced with a dedicated provider in production.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Where the SQLite database lives. Optional; defaults to data/bidoor.db
# DATABASE_PATH=data/bidoor.db

# Salt used when hashing caller IP addresses for rate limiting.
# Optional but recommended. Raw IPs are never stored — only a hash, used purely
# as a counting key. Without a salt an IPv4 hash is reversible by brute force
# (the whole space is four billion addresses).
# RATE_LIMIT_SALT=

# Shared secret for the /admin console and the /api/reconcile endpoint.
# Required for either to work, with no default — an admin console that falls
# back to a known token is worse than no console.
ADMIN_TOKEN=

# Where someone whose payment did not match the exact amount is told to write.
# An email or an @handle. Shown verbatim in the failure message, so make it
# something a person actually reads: applying a stray payment is manual work
# done from /admin, not an automated recovery.
SUPPORT_CONTACT=

# Public origin, used to build absolute URLs for link previews (og:image).
# SITE_URL=https://bidoor.lol

# How many proxies sit in front of this app and append to x-forwarded-for.
# Default 1, which matches Vercel and Cloudflare.
#
# This decides which entry of that header is trusted. Proxies APPEND, so the
# trustworthy address is counted from the RIGHT; the left-most entry is whatever
# the caller sent. Setting this too high makes us read a caller-controlled value
# and hands them their own rate-limit bucket.
# TRUSTED_PROXY_HOPS=1

# Allow requests with no trustworthy client address (local development only).
#
# Off by default and it must stay off in production: without a client address
# there is no rate limiting, and bid creation reserves a payment amount. With
# this unset and no proxy header present, bidding is refused rather than
# silently unlimited.
# ALLOW_UNTRUSTED_CLIENT_IP=true
